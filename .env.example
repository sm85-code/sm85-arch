# --- Core ---
APP_TITLE=SM85 Arch API
DATABASE_URL=postgresql://user:password@host:5432/siabumdes?sslmode=require
POSTGRES_SSL=true
JWT_SECRET=replace-with-long-random-string
JWT_COOKIE_NAME=bumdes_token
JWT_EXPIRE_HOURS=168

# Split DigitalOcean hostnames (frontend static site + backend web service)
CORS_ORIGINS=https://frontend-xxxxx.ondigitalocean.app,http://localhost:3000
CORS_ORIGIN_REGEX=^https://.*\.ondigitalocean\.app$
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_PATH=/

# Optional Google Drive (not wired in this PR)
# GDRIVE_REDIRECT_URI=https://api-xxxxx.ondigitalocean.app/api/gdrive/oauth-callback
# GDRIVE_OAUTH_REDIRECT=https://frontend-xxxxx.ondigitalocean.app/transactions
# GDRIVE_FOLDER_ID=
# GDRIVE_OAUTH_CLIENT_DATA=
