# --- Core ---
APP_TITLE=SM85 Arch API
DATABASE_URL=postgresql://user:password@host:5432/siabumdes?sslmode=require

# --- Tenant modules (each on its own isolated Postgres instance/database) ---
DATABASE_URL_MADRASAH=postgresql://user:password@host:5432/madrasah?sslmode=require
# Bootstrap gate for GET /api/madrasah/seed-now (shared-host P0).
# Required to seed without an existing admin session. In production the
# endpoint rejects anonymous callers unless this header matches:
#   X-Madrasah-Seed-Secret: <same value>
# Leave empty to force admin-login-only seeding.
MADRASAH_SEED_SECRET=
# APP_ENV=production disables anonymous seed-now even in misconfigured deploys.
APP_ENV=development
DATABASE_URL_TOKO=postgresql://user:password@host:5432/toko?sslmode=require
DATABASE_URL_MARKETPLACE_ERP=postgresql://user:password@host:5432/marketplace_erp?sslmode=require

# Toko payment/shipping -- NOT wired to real APIs yet, see
# tenants/toko/modules/toko/infrastructure/payment_ipaymu.py and
# shipping_biteship.py. Leave blank until merchant verification is done;
# endpoints that need them return HTTP 503 while unset.
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_MODE=sandbox
BITESHIP_API_KEY=
# "Masuk dengan Google" untuk toko -- buat OAuth Client ID (jenis "Web
# application") di Google Cloud Console, isi authorized origin dengan URL
# frontend-toko. Kosongkan untuk menonaktifkan login Google (HTTP 503).
GOOGLE_CLIENT_ID=
POSTGRES_SSL=true
JWT_SECRET=replace-with-long-random-string
# Optional per-tenant JWT secrets (SIABUMDES B1 isolation). When unset, each
# module falls back to JWT_SECRET so live keeps working after deploy.
# Recommended migration:
#   1) Deploy code (aud/iss stamped on new logins; legacy tokens still accepted).
#   2) Optionally set JWT_SECRET_BUMDES / _MADRASAH / _TOKO equal to JWT_SECRET.
#   3) After JWT_EXPIRE_HOURS (or forced re-login), rotate each to a distinct value.
# Until step 3, a Bearer token from another tenant that still lacks aud/iss can
# verify under the shared secret (cookie names differ; residual risk is mainly
# Authorization: Bearer cross-paste). Distinct secrets close that gap.
JWT_SECRET_BUMDES=
JWT_SECRET_MADRASAH=
JWT_SECRET_TOKO=
JWT_SECRET_MARKETPLACE_ERP=
JWT_COOKIE_NAME=bumdes_token
JWT_EXPIRE_HOURS=168

# Split DigitalOcean hostnames (frontend static site + backend web service)
CORS_ORIGINS=https://frontend-xxxxx.ondigitalocean.app,https://banihusen-sgxg4.ondigitalocean.app,http://localhost:3000
CORS_ORIGIN_REGEX=^https://.*\.ondigitalocean\.app$
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_PATH=/

# Google OAuth (optional alternative to service account). Refresh token must
# be set via platform env only — /api/admin/gdrive/oauth-callback never returns
# refresh_token in JSON (admin session + signed state required).
# Google Drive — service account (no admin OAuth)
GDRIVE_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Folder terpisah untuk foto produk toko -- sengaja beda dari GDRIVE_FOLDER_ID
# (yang dipakai laporan BUMDes) supaya tidak tercampur. Pakai service account
# yang sama di atas.
GDRIVE_FOLDER_ID_TOKO=

# --- Kop surat / tanda tangan export PDF & Excel ---
REPORT_ORG_NAME=BUMDes Contoh
REPORT_ORG_LEGAL_NAME=Badan Usaha Milik Desa Contoh
REPORT_ORG_ADDRESS=Jl. Desa No. 1
REPORT_ORG_VILLAGE=Desa Contoh
REPORT_ORG_DISTRICT=Kecamatan Contoh
REPORT_ORG_REGENCY=Kabupaten Contoh
REPORT_ORG_PROVINCE=Jawa Barat
REPORT_ORG_PHONE=
REPORT_ORG_EMAIL=
REPORT_ORG_TAGLINE=Laporan Keuangan
REPORT_PRIMARY_COLOR=1F4E79
REPORT_SIGN_LEFT_TITLE=Direktur / Ketua
REPORT_SIGN_LEFT_NAME=
REPORT_SIGN_MID_TITLE=Bendahara
REPORT_SIGN_MID_NAME=
REPORT_SIGN_RIGHT_TITLE=Mengetahui
REPORT_SIGN_RIGHT_NAME=
